diff --git a/services/Volume.qml b/services/Volume.qml
new file mode 100644
index 0000000..a16aa6e
--- /dev/null
+++ b/services/Volume.qml
@@ -0,0 +1,43 @@
+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Services.Pipewire
+
+// Default sink volume and a 1.2 s "shown" flag, read by every bar's pill
+// so the readout appears inside each bar when the volume changes.
+Singleton {
+    id: root
+
+    PwObjectTracker {
+        objects: [Pipewire.defaultAudioSink]
+    }
+
+    readonly property var audio: Pipewire.defaultAudioSink?.audio ?? null
+    readonly property bool muted: audio?.muted ?? false
+    // PipeWire allows boosting past 100%; the readout caps at 100
+    readonly property int volume: audio ? Math.min(100, Math.round(audio.volume * 100)) : 0
+
+    property bool shown: false
+    property bool armed: false   // ignore the initial values at startup
+
+    Timer {
+        interval: 1000
+        running: true
+        onTriggered: root.armed = true
+    }
+
+    Timer {
+        id: hideTimer
+        interval: 1200
+        onTriggered: root.shown = false
+    }
+
+    function poke() {
+        if (!armed) return
+        shown = true
+        hideTimer.restart()
+    }
+
+    onVolumeChanged: poke()
+    onMutedChanged: poke()
+}
